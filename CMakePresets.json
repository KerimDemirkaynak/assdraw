{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "ASSDRAW_BUNDLED_WX": "ON"
      }
    },
    {
      "name": "release-x64",
      "displayName": "Release x64 (MSVC + wxWidgets 3.3.4)",
      "inherits": "windows-msvc-base",
      "architecture": "x64"
    },
    {
      "name": "debug-x64",
      "displayName": "Debug x64 (MSVC + wxWidgets 3.3.4)",
      "inherits": "windows-msvc-base",
      "architecture": "x64"
    },
    {
      "name": "debug-x86",
      "displayName": "Debug x86 (MSVC + wxWidgets 3.3.4)",
      "inherits": "windows-msvc-base",
      "architecture": "Win32"
    }
  ],
  "buildPresets": [
    {
      "name": "release-x64",
      "configurePreset": "release-x64",
      "configuration": "Release",
      "targets": [
        "assdraw"
      ]
    },
    {
      "name": "debug-x64",
      "configurePreset": "debug-x64",
      "configuration": "Debug",
      "targets": [
        "assdraw"
      ]
    },
    {
      "name": "debug-x86",
      "configurePreset": "debug-x86",
      "configuration": "Debug",
      "targets": [
        "assdraw"
      ]
    }
  ]
}
